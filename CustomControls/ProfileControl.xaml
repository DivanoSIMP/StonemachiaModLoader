<UserControl x:Class="StonemachiaModLoader.CustomControls.ProfileControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:StonemachiaModLoader.CustomControls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d"
             Height="50" d:DesignWidth="800">

    <Border x:Name="ProfileBorder" 
            Background="{StaticResource Border}"
            BorderBrush="{StaticResource Surface}"
            BorderThickness="2" CornerRadius="15">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Profile name -->
            <TextBlock Grid.Column="0" x:Name="ProfileName" Text="Profile Test"
                   FontSize="18" Foreground="{StaticResource Text}"
                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="25,0,0,0"/>

            <!-- Trash icon -->
            <Button Grid.Column="2" Style="{StaticResource TrashIconButton}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,25,0"
                    Cursor="Hand" Click="DeleteButton_Click"/>
            
            <!-- Selector -->
            <Border x:Name="ProfileSelector"
                    Grid.Column="1" HorizontalAlignment="Right"
                    CornerRadius="10" Height="22" Margin="0,0,25,0"
                    BorderBrush="{StaticResource Accent}"
                    BorderThickness="1.5" Visibility="Hidden">
                <Border.Background>
                    <SolidColorBrush Color="{Binding Source={StaticResource Accent}, Path=Color}"
                                     Opacity="0.2"/>
                </Border.Background>

                <StackPanel Orientation="Horizontal" Margin="10,0"
                            VerticalAlignment="Center">
                    <iconPacks:PackIconLucide Kind="Layers2"
                                                     Foreground="{StaticResource Accent}"/>
                    <TextBlock Text="Current" Padding="5,0" FontWeight="DemiBold"
                               FontSize="12"
                               Foreground="{StaticResource Accent}"/>
                    
                </StackPanel>

            </Border>

            <!-- Interaction rect -->
            <Rectangle Grid.ColumnSpan="2" x:Name="ProfileRect" Fill="Transparent"
                       MouseLeftButtonDown="ProfileRect_MouseLeftButtonDown" 
                       MouseEnter="ProfileRect_MouseEnter" MouseLeave="ProfileRect_MouseLeave" Cursor="Hand"/>
        </Grid>
    </Border>
</UserControl>
