<Page x:Class="StonemachiaModLoader.ProfilesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:StonemachiaModLoader"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      xmlns:uc="clr-namespace:StonemachiaModLoader.CustomControls"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800" Background="{StaticResource BackgroundToSource}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Sidebar -->
        <Border x:Name="Sidebar" Grid.Row="1" Panel.ZIndex="2"
                HorizontalAlignment="Left"
                Width="50" Background="{StaticResource Border}"
                BorderBrush="{StaticResource Accent}" BorderThickness="0,0,1,0">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch">
                <!-- Header -->
                <StackPanel Orientation="Horizontal" Margin="10">
                    <iconPacks:PackIconLucide Kind="TextAlignJustify" HorizontalAlignment="Left"
                                              Foreground="{StaticResource Muted}"
                                              Width="25" Height="25"/>
                    <TextBlock Text="Settings" Padding="5,0" VerticalAlignment="Center"
                               Foreground="{StaticResource Muted}" FontWeight="DemiBold"
                               Opacity="0.0" Name="HeaderText"/>
                </StackPanel>

                <Separator Background="{StaticResource Muted}" Margin="10,0"/>

                <!-- Open Folder -->
                <Button Style="{StaticResource RoundedButton_Muted}" Margin="0,10,0,5"
                        Cursor="Hand" Click="OpenFolderButton_Click" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="Folder" VerticalAlignment="Center"
                                                  Width="25" Height="25"/>
                        <TextBlock Text="Open Folder" Padding="5,0"
                                   FontWeight="DemiBold" VerticalAlignment="Center"
                                   Opacity="0.0" Name="FolderButtonText"/>
                    </StackPanel>
                </Button>

                <!-- Open Configs -->
                <Button Style="{StaticResource RoundedButton_Muted}" Margin="0,5"
                        Cursor="Hand" Click="OpenConfigsButton_Click" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Height="28">
                        <iconPacks:PackIconLucide Kind="Settings" VerticalAlignment="Center"
                                                  Width="25" Height="25"/>
                        <TextBlock Text="Open Config" Padding="5,0"
                                   FontWeight="DemiBold" VerticalAlignment="Center"
                                   Opacity="0.0" Name="SettingsButtonText"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <Border.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation From="50" To="250" Duration="0:0:0.120"
                                             Storyboard.TargetName="Sidebar"
                                             Storyboard.TargetProperty="Width"/>

                            <DoubleAnimation From="0.0" To="1.0" Duration="0:0:0.120"
                                             Storyboard.TargetName="HeaderText"
                                             Storyboard.TargetProperty="Opacity"/>

                            <DoubleAnimation From="0.0" To="1.0" Duration="0:0:0.120"
                                             Storyboard.TargetName="FolderButtonText"
                                             Storyboard.TargetProperty="Opacity"/>

                            <DoubleAnimation From="0.0" To="1.0" Duration="0:0:0.120"
                                             Storyboard.TargetName="SettingsButtonText"
                                             Storyboard.TargetProperty="Opacity"/>
                            
                            <DoubleAnimation From="0.0" To="4.0" Duration="0:0:0.120"
                                             Storyboard.TargetName="ProfilesBlur"
                                             Storyboard.TargetProperty="Radius"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation From="250" To="50" Duration="0:0:0.120"
                                             Storyboard.TargetName="Sidebar"
                                             Storyboard.TargetProperty="Width"/>

                            <DoubleAnimation From="1.0" To="0.0" Duration="0:0:0.120"
                                             Storyboard.TargetName="HeaderText"
                                             Storyboard.TargetProperty="Opacity"/>

                            <DoubleAnimation From="1.0" To="0.0" Duration="0:0:0.120"
                                             Storyboard.TargetName="FolderButtonText"
                                             Storyboard.TargetProperty="Opacity"/>

                            <DoubleAnimation From="1.0" To="0.0" Duration="0:0:0.120"
                                             Storyboard.TargetName="SettingsButtonText"
                                             Storyboard.TargetProperty="Opacity"/>
                            
                            <DoubleAnimation From="4.0" To="0.0" Duration="0:0:0.120"
                                             Storyboard.TargetName="ProfilesBlur"
                                             Storyboard.TargetProperty="Radius"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="0"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1"
                Padding="20,4">
            <Grid>
                <!-- TO-DO
                <StackPanel Height="38"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left">
                    
                    

                    <Button Style="{StaticResource RoundedButton_Muted}" BorderThickness="0"
                            Cursor="Hand">
                        <iconPacks:PackIconLucide Kind="ListFilter" Foreground="{StaticResource Text}"
                                                  VerticalAlignment="Center"/>
                    </Button>

                    <TextBox Background="Transparent" BorderBrush="{StaticResource Border}"
                             Foreground="{StaticResource Text}" TextAlignment="Left"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             SelectionBrush="{StaticResource Muted}" CaretBrush="{StaticResource Muted}"
                             IsReadOnly="False" Width="100" Height="25" Cursor="IBeam"/>
                </StackPanel>
                -->

                <StackPanel Height="38"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">

                    <!-- Launch game -->
                    <Button Grid.Column="2" Cursor="Hand" Margin="0,0,10,0"
                            Style="{StaticResource RoundedButton_Accent}"
                            Click="LaunchGameButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconLucide Kind="Play" Foreground="{StaticResource Text}"
                                                      VerticalAlignment="Center"/>
                            <TextBlock Text="LAUNCH GAME" Margin="5,0,0,0" 
                                       Foreground="{StaticResource Text}"/>
                        </StackPanel>
                    </Button>

                    <!-- New Profile -->
                    <Button Margin="0,0,10,0"
                            Style="{StaticResource RoundedButton_Muted}"
                            Cursor="Hand" Click="ProfileCreationButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="FolderPlus" VerticalAlignment="Center"/>
                            <TextBlock Text="New profile" Padding="10,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

        </Border >

        <ScrollViewer Grid.Row="1" Margin="50,0,0,0">
            <ScrollViewer.Effect>
                <BlurEffect x:Name="ProfilesBlur" Radius="0" KernelType="Gaussian"/>
            </ScrollViewer.Effect>

            <StackPanel Margin="10" Name="ProfilesStackPanel">
                <Border x:Name="WARNING"
                    Background="{DynamicResource WarningBackground}"
                    BorderBrush="{DynamicResource Warning}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="12"
                    Margin="0,12,0,16">
                
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide
                            Kind="TriangleAlert"
                            Width="20"
                            Height="20"
                            Foreground="{DynamicResource Warning}"
                            VerticalAlignment="Top"
                            Margin="0,2,10,0" />

                        <StackPanel>
                            <TextBlock
                                Text="Profiles Under Development"
                                Foreground="{DynamicResource Text}"
                                FontWeight="SemiBold"
                                FontSize="13" />

                            <TextBlock
                                Foreground="{DynamicResource Text}"
                                FontSize="12"
                                TextWrapping="WrapWithOverflow"
                                Margin="0,4,0,0">
                                The Profiles feature is still under development.
                                Some features may be incomplete or behave unexpectedly.
                                Thank you for your patience!
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>


                <!-- Profiles will be dynamically added here -->
                <uc:ProfileControl/> <!-- Example profile -->
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
